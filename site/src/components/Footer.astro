---
import { EMPRESA, MENU_PRINCIPAL, waLink } from '../config.mjs';
import { clustersComContagem } from '../lib/conteudo.mjs';

const clusters = clustersComContagem(MENU_PRINCIPAL);
const col1 = clusters.slice(0, 6);
const col2 = clusters.slice(6, 12);
const ano = new Date().getFullYear();
const e = EMPRESA.endereco;
---

<footer class="ft">
  <div class="container">
    <div class="ft__grid">
      <div>
        <div class="ft__logo">
          {/* Proporção real 571x213. Estava 170x42 e o logo saía achatado. */}
          <img src="/img/logo-previsio-mono.png" alt="Previsio Engenharia" width="139" height="52" />
        </div>
        <p class="ft__nap">
          {e.rua}<br />
          {e.bairro} — {e.cidade}/{e.uf}<br />
          CEP {e.cep}
        </p>
        <p class="ft__nap">
          <a href={`tel:${EMPRESA.telefoneLink}`} data-evento="click_telefone">{EMPRESA.telefone}</a><br />
          <a href={`mailto:${EMPRESA.email}`}>{EMPRESA.email}</a>
        </p>
      </div>

      <div>
        <h4>Soluções</h4>
        <ul>{col1.map((c) => <li><a href={c.pilar}>{c.rotulo}</a></li>)}</ul>
      </div>

      <div>
        <h4>Mais soluções</h4>
        <ul>{col2.map((c) => <li><a href={c.pilar}>{c.rotulo}</a></li>)}</ul>
      </div>

      <div>
        <h4>Institucional</h4>
        <ul>
          <li><a href="/quem-somos">Quem somos</a></li>
          <li><a href="/servicos">Serviços</a></li>
          <li><a href="/artigos">Artigos</a></li>
          <li><a href="/download">Downloads</a></li>
          <li><a href="/informacoes">Todas as páginas</a></li>
          <li><a href="/mapa-site">Mapa do site</a></li>
          <li><a href="/contato">Contato</a></li>
        </ul>
        <h4 style="margin-top:22px">Outros canais</h4>
        <ul>
          <li><a href="https://ferramentas.previsio.com.br" rel="noopener">Ferramentas e calculadoras</a></li>
          <li><a href="https://cursos.previsio.com.br" rel="noopener">Cursos EAD</a></li>
        </ul>
      </div>
    </div>

    <div class="ft__bar">
      <span>© {ano} {EMPRESA.nome}. Desde {EMPRESA.desde}.</span>
      <span>{EMPRESA.subtitulo}</span>
    </div>
  </div>
</footer>

<a
  class="wa-float"
  href={waLink()}
  target="_blank"
  rel="noopener"
  aria-label="Falar no WhatsApp"
  data-evento="whatsapp_float"
>
  <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/>
    <path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.3c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3c-.9-1.4-1.3-3-1.3-4.6C3.5 7.3 7.3 3.5 12 3.5S20.5 7.3 20.5 12 16.7 20.2 12 20.2z"/>
  </svg>
</a>
