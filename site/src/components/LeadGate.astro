---
import { EMPRESA, WEBHOOK_LEAD, WHATSAPP_MSG } from '../config.mjs';

// Lead gate — nenhuma ação de WhatsApp abre o wa.me sem antes capturar dados.
// Um único gate para o site todo: o botão flutuante e QUALQUER link/CTA de
// WhatsApp passam por este mini-formulário, que posta ao n8n e dispara
// generate_lead ANTES de seguir ao WhatsApp. É a lógica da LP-01, generalizada.
---

<!-- Widget flutuante (estilo RD Station): abre o gate, não o wa.me direto -->
<button class="wa-float" type="button" data-gate-open="whatsapp_float" aria-label="Falar com um especialista">
  <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/>
    <path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.3c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3c-.9-1.4-1.3-3-1.3-4.6C3.5 7.3 7.3 3.5 12 3.5S20.5 7.3 20.5 12 16.7 20.2 12 20.2z"/>
  </svg>
  <span>Fale com um especialista</span>
</button>

<div class="gate" id="lead-gate" hidden>
  <div class="gate__overlay" data-gate-close></div>
  <div class="gate__box" role="dialog" aria-modal="true" aria-labelledby="gate-ttl">
    <button class="gate__x" type="button" data-gate-close aria-label="Fechar">&times;</button>
    <h3 id="gate-ttl">Fale com um especialista</h3>
    <p class="gate__sub">Deixe seu contato e continue a conversa no WhatsApp com a nossa equipe.</p>
    <form id="gate-form" novalidate>
      <input name="nome" type="text" placeholder="Seu nome *" required autocomplete="name" />
      <input name="telefone" type="tel" placeholder="WhatsApp (DDD + número) *" required autocomplete="tel" />
      <input name="empresa" type="text" placeholder="Empresa" autocomplete="organization" />
      <button type="submit" class="btn btn--green btn--block btn--lg">Continuar no WhatsApp</button>
      <p class="gate__erro" hidden>Não foi possível enviar agora. Tente novamente.</p>
    </form>
  </div>
</div>

<script define:vars={{ WHATSAPP: EMPRESA.whatsapp, WEBHOOK: WEBHOOK_LEAD, MSG_PADRAO: WHATSAPP_MSG }}>
  const gate = document.getElementById('lead-gate');
  const form = document.getElementById('gate-form');
  let waPendente = null; // destino de WhatsApp que originou a abertura
  let canal = 'whatsapp_gate';

  const abrir = () => {
    gate.hidden = false;
    document.body.style.overflow = 'hidden';
    setTimeout(() => form.querySelector('input')?.focus(), 40);
  };
  const fechar = () => {
    gate.hidden = true;
    document.body.style.overflow = '';
    form.querySelector('.gate__erro').hidden = true;
  };

  // Extrai a mensagem original de um link wa.me (?text=), para preservar o contexto
  function msgDe(url) {
    try {
      return new URL(url).searchParams.get('text') || MSG_PADRAO;
    } catch {
      return MSG_PADRAO;
    }
  }

  // Interceptação global: qualquer link de WhatsApp ou gatilho explícito abre o gate
  document.addEventListener('click', (e) => {
    const alvo = e.target.closest('a[href*="wa.me"], a[href*="api.whatsapp"], a[href*="whatsapp.com/send"], [data-gate-open]');
    if (!alvo) return;
    e.preventDefault();
    const href = alvo.getAttribute('href');
    waPendente = href ? msgDe(href) : MSG_PADRAO;
    canal = alvo.getAttribute('data-gate-open') || alvo.getAttribute('data-evento') || 'whatsapp_gate';
    abrir();
  });

  gate.querySelectorAll('[data-gate-close]').forEach((el) => el.addEventListener('click', fechar));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && !gate.hidden && fechar());

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type=submit]');
    const dados = Object.fromEntries(new FormData(form).entries());
    if (!dados.nome?.trim() || !dados.telefone?.trim()) return;

    // Abre a aba em branco AINDA no gesto do usuário (driblar bloqueador de popup)
    const aba = window.open('about:blank', '_blank');
    btn.disabled = true;
    btn.setAttribute('aria-busy', 'true');

    // Dispara a conversão e posta o lead — sem bloquear o redirecionamento
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'generate_lead', canal, form_id: 'gate' });
    fetch(WEBHOOK, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...dados, form_id: 'gate', canal, page_url: location.href }),
    }).catch(() => {});

    // Monta a mensagem com os dados capturados e segue ao WhatsApp
    const ctx = waPendente && waPendente !== MSG_PADRAO ? ` ${waPendente}` : '';
    const msg = `Olá, sou ${dados.nome}${dados.empresa ? ` da ${dados.empresa}` : ''}.${ctx || ' Gostaria de falar com um especialista.'}`;
    const url = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
    if (aba) aba.location = url;
    else window.location = url;
    fechar();
    btn.disabled = false;
    btn.removeAttribute('aria-busy');
    form.reset();
  });
</script>
