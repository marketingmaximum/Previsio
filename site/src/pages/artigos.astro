---
import Base from '../layouts/Base.astro';
import { porPath, ARTIGOS, ARTIGOS_INFO } from '../lib/conteudo.mjs';

const pagina = porPath('/artigos');

// Artigos novos (informacionais) primeiro; depois os migrados do site atual.
const novos = ARTIGOS_INFO.map((a) => ({ path: a.path, h1: a.h1, capa: '/img/hero/nr-12.jpg', novo: true }));
const migrados = ARTIGOS.map((p) => {
  const m = (p.bodyHtml ?? '').match(/src="([^"]+\.(?:webp|jpg|png))"/i);
  return { path: p.path, h1: p.h1, capa: m ? m[1].replace('https://www.previsio.com.br', '') : null };
});
const posts = [...novos, ...migrados];
---

<Base
  title={pagina?.title ?? 'Artigos - Previsio Engenharia'}
  description={pagina?.descriptionCorrigida ?? pagina?.description}
  canonical="https://www.previsio.com.br/artigos"
>
  <section class="hero hero--page">
    <div class="hero__media"><img src="/img/hero/institucional.jpg" alt="" width="1600" height="1064" /></div>
    <div class="hero__scrim"></div>
    <div class="container">
      <div class="hero__in">
        <ol class="crumb"><li><a href="/">Home</a></li><li>Artigos</li></ol>
        <h1 class="hero__title">Artigos</h1>
        <p class="hero__sub" style="margin-bottom:0">Conteúdo técnico sobre segurança do trabalho e conformidade.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="grid grid--3">
        {posts.map((p) => (
          <a class="post" href={p.path}>
            <div class="post__capa">
              {p.capa ? <img src={p.capa} alt={p.h1} loading="lazy" /> : <span class="post__ph" aria-hidden="true">Previsio</span>}
              {p.novo && <span class="post__tag">NR-12</span>}
            </div>
            <h3>{p.h1}</h3>
            <span class="post__link">Ler artigo →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
