---
import Base from '../layouts/Base.astro';
import Cidades from '../components/Cidades.astro';
import FAQ from '../components/FAQ.astro';
import Interludio from '../components/Interludio.astro';
import { EMPRESA, waLink } from '../config.mjs';
import { PAGINAS, porCluster, trilha, heroDe } from '../lib/conteudo.mjs';
import { conteudoEnriquecido } from '../conteudo/index.mjs';
import { ROTULOS } from '../../tools/extract/taxonomia.mjs';
import iconExecucao from '../icons/execucao.svg?raw';
import iconLaudo from '../icons/laudo.svg?raw';
import iconEscudo from '../icons/escudo.svg?raw';
import iconSuporte from '../icons/suporte.svg?raw';

// Diferenciais da empresa — consistentes em toda página de serviço (é a
// promessa de marca, verdadeira e reutilizável). Dá cara de página de serviço,
// não de post de blog.
const BENEFICIOS = [
  { icon: iconExecucao, t: 'Projeta, executa e atesta', d: 'Projeto, execução e laudo com um só fornecedor — sem repassar a responsabilidade.' },
  { icon: iconLaudo, t: 'Laudo com ART', d: 'Documento com responsabilidade técnica de engenheiro, válido perante a fiscalização.' },
  { icon: iconEscudo, t: 'Desde 2016', d: 'Mais de mil indústrias atendidas, do projeto à obra.' },
  { icon: iconSuporte, t: 'Atendimento nacional', d: 'Sede em São Leopoldo/RS, com projetos em todo o Brasil e no exterior.' },
];

/**
 * Gera as 234 rotas restantes (a home tem página própria).
 *
 * Toda URL sai daqui, do mesmo arquivo de dados que veio do crawl — é o que
 * torna a cobertura auditável: `astro build` produzindo 235 arquivos é a
 * prova de que nenhuma URL se perdeu.
 */
export function getStaticPaths() {
  // Home, institucionais e o índice de artigos têm páginas dedicadas em
  // src/pages/*.astro — este catch-all cobre só serviços, pilares e posts.
  // Definido aqui dentro: getStaticPaths roda em escopo isolado no Astro.
  const DEDICADAS = new Set(['home', 'institucional', 'indice-artigos']);
  return PAGINAS.filter((p) => !DEDICADAS.has(p.tipo)).map((p) => ({
    params: { slug: p.path.replace(/^\//, '') },
    props: { pagina: p },
  }));
}

const { pagina } = Astro.props;
const caminho = trilha(pagina);
const irmas = pagina.cluster ? porCluster(pagina.cluster) : [];

// Conteúdo novo, quando existe, tem prioridade sobre o corpo extraído. Sem
// entrada, cai no original — a migração de copy é incremental, página a página.
const enriquecido = conteudoEnriquecido(pagina.path);

// As URLs de imagem são preservadas (§3.5 do plano) — só deixo relativas para
// não apontar ao domínio antigo durante o desenvolvimento.
const corpo = (enriquecido?.corpo ?? pagina.bodyHtml ?? '').replaceAll(
  'https://www.previsio.com.br',
  '',
);

// Quebra o corpo num <h2> próximo do meio, para inserir um bloco visual entre
// as duas metades — evita o "muro de texto" das páginas internas.
function dividirCorpo(html) {
  const idxs = [...html.matchAll(/<h2[\s>]/g)].map((m) => m.index).filter((i) => i > 40);
  if (idxs.length < 2) return [html, ''];
  const meio = html.length / 2;
  const corte = idxs.reduce((b, i) => (Math.abs(i - meio) < Math.abs(b - meio) ? i : b));
  return [html.slice(0, corte), html.slice(corte)];
}
const [corpoA, corpoB] = dividirCorpo(corpo);

// Estilo do interlúdio escolhido pelo slug — determinístico e estável, mas
// varia entre páginas para o site não ficar monótono.
const hashSlug = [...pagina.slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);

const ehArtigo = pagina.tipo === 'artigo';
const ehPilar = pagina.tipo === 'pilar';
const rotuloCluster = pagina.cluster ? ROTULOS[pagina.cluster] : null;

// Pilar = hub do cluster: todas as páginas-irmãs (menos o próprio pilar),
// que hoje ficam soltas na raiz, viram uma grade navegável. É malha interna
// e cobertura de tópico — SEO e GEO — sem inventar copy.
const filhas = ehPilar ? irmas.filter((p) => p.path !== pagina.path) : [];

// Serviços relacionados nas folhas — substitui a lista da sidebar por cards.
const relacionadas = irmas.filter((p) => p.path !== pagina.path).slice(0, 6);

// Páginas de treinamento ganham o bloco das 3 modalidades (pedido do cliente).
const ehTreinamento = /treinamento/.test(pagina.slug) || pagina.cluster === 'treinamentos';
const MODALIDADES = [
  { t: 'In-company', d: 'Presencial, na sua empresa, com conteúdo adaptado à operação.' },
  { t: 'Remoto síncrono', d: 'Ao vivo, com o instrutor em tempo real via Teams.' },
  { t: 'Flexível (EAD)', d: 'No seu ritmo, pela plataforma de cursos.', href: 'https://cursos.previsio.com.br' },
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: caminho.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: `https://www.previsio.com.br${c.href}` } : {}),
  })),
};

// Com conteúdo enriquecido, um @graph: Breadcrumb + FAQPage (sinal semântico
// para GEO — o rich result de FAQ acabou, o valor de extração por IA não).
const schema =
  enriquecido?.faq?.length
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          breadcrumb,
          {
            '@type': 'FAQPage',
            mainEntity: enriquecido.faq.map((it) => ({
              '@type': 'Question',
              name: it.q,
              acceptedAnswer: { '@type': 'Answer', text: it.a },
            })),
          },
        ],
      }
    : breadcrumb;
---

<Base
  title={pagina.title}
  description={pagina.descriptionCorrigida ?? pagina.description}
  canonical={`https://www.previsio.com.br${pagina.path}`}
  schema={schema}
>
  <section class="hero hero--page">
    <div class="hero__media">
      <img src={heroDe(pagina)} alt="" width="1600" height="1064" />
    </div>
    <div class="hero__scrim"></div>

    <div class="container">
      <div class="hero__in">
        <ol class="crumb">
          {caminho.map((c) => (
            <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>
          ))}
        </ol>
        {rotuloCluster && pagina.cluster !== 'institucional' && !ehArtigo && (
          <span class="eyebrow eyebrow--light">{rotuloCluster}</span>
        )}
        <h1 class="hero__title">{pagina.h1}</h1>
        {!ehArtigo && (
          <>
            <p class="hero__sub">Projeto, execução e laudo com engenheiro responsável — atendimento em todo o Brasil.</p>
            <div class="hero__cta">
              <a href="/contato" class="btn btn--green">Solicitar orçamento</a>
              <a href={waLink(`Olá, gostaria de saber mais sobre ${pagina.h1}.`)} class="btn btn--ghost" data-evento="whatsapp_hero">Falar no WhatsApp</a>
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  {ehPilar ? (
    <>
      {/* Pilar/hub: largura total, sem sidebar — o próprio hub é a navegação */}
      <section class="sec">
        <div class="container container--narrow">
          {enriquecido?.resposta && <div class="resposta"><p>{enriquecido.resposta}</p></div>}
          {corpoB ? (
            <>
              <div class="prose" set:html={corpoA} />
              <Interludio variante={hashSlug % 3} titulo={pagina.h1} contexto={rotuloCluster} />
              <div class="prose" set:html={corpoB} />
            </>
          ) : (
            <div class="prose" set:html={corpo} />
          )}
        </div>
      </section>

      {filhas.length > 0 && (
        <section class="sec sec--soft">
          <div class="container">
            <div class="sec__head" style="text-align:center;margin:0 auto 34px">
              <span class="eyebrow">Soluções</span>
              <h2 class="sec__title">Serviços de {rotuloCluster}</h2>
            </div>
            <div class="hub hub--3">
              {filhas.map((p) => (
                <a class="hub__i" href={p.path}>
                  <strong>{p.h1}</strong>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      {enriquecido?.faq && (
        <section class="sec">
          <div class="container container--narrow"><FAQ itens={enriquecido.faq} /></div>
        </section>
      )}

      <section class="cta-foto">
        <img src={heroDe(pagina)} alt="" />
        <div class="container">
          <div style="max-width:640px">
            <h2 class="sec__title">Fale com nossos especialistas</h2>
            <p style="color:var(--on-navy);font-size:1.07rem;margin-bottom:26px">
              Atendimento em todo o território nacional, com resposta no mesmo dia útil.
            </p>
            <div class="hero__cta">
              <a href="/contato" class="btn btn--green btn--lg">Solicitar um orçamento</a>
              <a href={waLink(`Olá, gostaria de saber mais sobre ${pagina.h1}.`)} class="btn btn--ghost btn--lg" target="_blank" rel="noopener" data-evento="whatsapp_pilar">Falar no WhatsApp</a>
            </div>
          </div>
        </div>
      </section>
    </>
  ) : (
    <>
      {/* Faixa de prova — logo abaixo do hero, tira a cara de blog */}
      <div class="trust">
        <div class="container">
          <div class="trust__in">
            <div class="trust__i"><span class="trust__n">+1.000</span><span class="trust__l">indústrias atendidas</span></div>
            <div class="trust__i"><span class="trust__n">Desde {EMPRESA.desde}</span><span class="trust__l">no mercado</span></div>
            <div class="trust__i"><span class="trust__n">Projeto + Execução</span><span class="trust__l">no mesmo fornecedor</span></div>
            <div class="trust__i"><span class="trust__n">Laudo com ART</span><span class="trust__l">engenheiro responsável</span></div>
          </div>
        </div>
      </div>

      {/* Conteúdo: galeria real + resposta + texto, em largura de leitura */}
      <section class="sec">
        <div class="container container--narrow">
          {pagina.imagens.length > 0 && !ehArtigo && (
            <div class="galeria">
              {pagina.imagens.slice(0, 3).map((img) => (
                <img src={img.src} alt={img.alt ?? pagina.h1} width={img.width} height={img.height} loading="lazy" />
              ))}
            </div>
          )}

          {enriquecido?.resposta && <div class="resposta"><p>{enriquecido.resposta}</p></div>}

          {corpoB ? (
            <>
              <div class="prose" set:html={corpoA} />
              {/* Só variantes de CTA (0 e 2) — os "chips" duplicariam a seção
                  "Por que a Previsio" que vem logo abaixo. */}
              <Interludio variante={[0, 2][hashSlug % 2]} titulo={pagina.h1} contexto={rotuloCluster} />
              <div class="prose" set:html={corpoB} />
            </>
          ) : (
            <div class="prose" set:html={corpo} />
          )}
        </div>
      </section>

      {ehTreinamento && (
        <section class="sec sec--soft">
          <div class="container">
            <div class="sec__head" style="text-align:center;margin:0 auto 30px">
              <span class="eyebrow">Como participar</span>
              <h2 class="sec__title">Três modalidades de treinamento</h2>
            </div>
            <div class="grid grid--3">
              {MODALIDADES.map((m) => (
                <div class="card">
                  <h3>{m.t}</h3>
                  <p>{m.d}</p>
                  {m.href && <a class="card__link" href={m.href} rel="noopener">Ver cursos EAD →</a>}
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Por que a Previsio — cards de diferencial com ícones */}
      <section class="sec sec--soft">
        <div class="container">
          <div class="sec__head" style="text-align:center;margin:0 auto 34px">
            <span class="eyebrow">Por que a Previsio</span>
            <h2 class="sec__title">Do diagnóstico à obra, com respaldo de engenheiro</h2>
          </div>
          <div class="grid grid--4">
            {BENEFICIOS.map((b) => (
              <div class="card">
                <div class="card__ico" set:html={b.icon} />
                <h3>{b.t}</h3>
                <p>{b.d}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {enriquecido?.faq && (
        <section class="sec">
          <div class="container container--narrow"><FAQ itens={enriquecido.faq} /></div>
        </section>
      )}

      {relacionadas.length > 0 && (
        <section class="sec sec--soft">
          <div class="container">
            <div class="sec__head" style="text-align:center;margin:0 auto 30px">
              <span class="eyebrow">{rotuloCluster}</span>
              <h2 class="sec__title">Serviços relacionados</h2>
            </div>
            <div class="hub hub--3">
              {relacionadas.map((p) => (
                <a class="hub__i" href={p.path}><strong>{p.h1}</strong><span aria-hidden="true">→</span></a>
              ))}
            </div>
          </div>
        </section>
      )}

      {pagina.temCidades && (
        <section class="sec">
          <div class="container container--narrow"><Cidades termo={pagina.h1} /></div>
        </section>
      )}

      {/* CTA final com foto do cluster */}
      <section class="cta-foto">
        <img src={heroDe(pagina)} alt="" />
        <div class="container">
          <div style="max-width:640px">
            <h2 class="sec__title">Solicite um orçamento de {pagina.h1}</h2>
            <p style="color:var(--on-navy);font-size:1.07rem;margin-bottom:26px">
              Atendimento em todo o território nacional, com resposta no mesmo dia útil.
            </p>
            <div class="hero__cta">
              <a href="/contato" class="btn btn--green btn--lg">Solicitar orçamento</a>
              <a href={waLink(`Olá, gostaria de saber mais sobre ${pagina.h1}.`)} class="btn btn--ghost btn--lg" target="_blank" rel="noopener" data-evento="whatsapp_conteudo">Falar no WhatsApp</a>
            </div>
          </div>
        </div>
      </section>
    </>
  )}
</Base>
