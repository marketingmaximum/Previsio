---
import Base from '../layouts/Base.astro';
import Cidades from '../components/Cidades.astro';
import FAQ from '../components/FAQ.astro';
import Interludio from '../components/Interludio.astro';
import { EMPRESA, waLink } from '../config.mjs';
import { PAGINAS, porCluster, trilha, heroDe } from '../lib/conteudo.mjs';
import { conteudoEnriquecido } from '../conteudo/index.mjs';
import { ROTULOS } from '../../tools/extract/taxonomia.mjs';

/**
 * Gera as 234 rotas restantes (a home tem página própria).
 *
 * Toda URL sai daqui, do mesmo arquivo de dados que veio do crawl — é o que
 * torna a cobertura auditável: `astro build` produzindo 235 arquivos é a
 * prova de que nenhuma URL se perdeu.
 */
export function getStaticPaths() {
  // Home, institucionais e o índice de artigos têm páginas dedicadas em
  // src/pages/*.astro — este catch-all cobre só serviços, pilares e posts.
  // Definido aqui dentro: getStaticPaths roda em escopo isolado no Astro.
  const DEDICADAS = new Set(['home', 'institucional', 'indice-artigos']);
  return PAGINAS.filter((p) => !DEDICADAS.has(p.tipo)).map((p) => ({
    params: { slug: p.path.replace(/^\//, '') },
    props: { pagina: p },
  }));
}

const { pagina } = Astro.props;
const caminho = trilha(pagina);
const irmas = pagina.cluster ? porCluster(pagina.cluster) : [];

// Conteúdo novo, quando existe, tem prioridade sobre o corpo extraído. Sem
// entrada, cai no original — a migração de copy é incremental, página a página.
const enriquecido = conteudoEnriquecido(pagina.path);

// As URLs de imagem são preservadas (§3.5 do plano) — só deixo relativas para
// não apontar ao domínio antigo durante o desenvolvimento.
const corpo = (enriquecido?.corpo ?? pagina.bodyHtml ?? '').replaceAll(
  'https://www.previsio.com.br',
  '',
);

// Quebra o corpo num <h2> próximo do meio, para inserir um bloco visual entre
// as duas metades — evita o "muro de texto" das páginas internas.
function dividirCorpo(html) {
  const idxs = [...html.matchAll(/<h2[\s>]/g)].map((m) => m.index).filter((i) => i > 40);
  if (idxs.length < 2) return [html, ''];
  const meio = html.length / 2;
  const corte = idxs.reduce((b, i) => (Math.abs(i - meio) < Math.abs(b - meio) ? i : b));
  return [html.slice(0, corte), html.slice(corte)];
}
const [corpoA, corpoB] = dividirCorpo(corpo);

// Estilo do interlúdio escolhido pelo slug — determinístico e estável, mas
// varia entre páginas para o site não ficar monótono.
const hashSlug = [...pagina.slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);

const ehArtigo = pagina.tipo === 'artigo';
const ehPilar = pagina.tipo === 'pilar';
const rotuloCluster = pagina.cluster ? ROTULOS[pagina.cluster] : null;

// Pilar = hub do cluster: todas as páginas-irmãs (menos o próprio pilar),
// que hoje ficam soltas na raiz, viram uma grade navegável. É malha interna
// e cobertura de tópico — SEO e GEO — sem inventar copy.
const filhas = ehPilar ? irmas.filter((p) => p.path !== pagina.path) : [];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: caminho.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: `https://www.previsio.com.br${c.href}` } : {}),
  })),
};

// Com conteúdo enriquecido, um @graph: Breadcrumb + FAQPage (sinal semântico
// para GEO — o rich result de FAQ acabou, o valor de extração por IA não).
const schema =
  enriquecido?.faq?.length
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          breadcrumb,
          {
            '@type': 'FAQPage',
            mainEntity: enriquecido.faq.map((it) => ({
              '@type': 'Question',
              name: it.q,
              acceptedAnswer: { '@type': 'Answer', text: it.a },
            })),
          },
        ],
      }
    : breadcrumb;
---

<Base
  title={pagina.title}
  description={pagina.descriptionCorrigida ?? pagina.description}
  canonical={`https://www.previsio.com.br${pagina.path}`}
  schema={schema}
>
  <section class="hero hero--page">
    <div class="hero__media">
      <img src={heroDe(pagina)} alt="" width="1600" height="1064" />
    </div>
    <div class="hero__scrim"></div>

    <div class="container">
      <div class="hero__in">
        <ol class="crumb">
          {caminho.map((c) => (
            <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>
          ))}
        </ol>
        <h1 class="hero__title">{pagina.h1}</h1>
        {rotuloCluster && pagina.cluster !== 'institucional' && (
          <p class="hero__sub" style="margin-bottom:0">{rotuloCluster}</p>
        )}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="pagina">
        <div>
          {pagina.imagens.length > 0 && !ehArtigo && !ehPilar && (
            <div class="galeria">
              {pagina.imagens.slice(0, 3).map((img) => (
                <img src={img.src} alt={img.alt ?? pagina.h1} width={img.width} height={img.height} loading="lazy" />
              ))}
            </div>
          )}

          {enriquecido?.resposta && (
            <div class="resposta">
              <p>{enriquecido.resposta}</p>
            </div>
          )}

          {corpoB && !ehPilar ? (
            <>
              <div class="prose" set:html={corpoA} />
              <Interludio variante={hashSlug % 3} titulo={pagina.h1} contexto={rotuloCluster} />
              <div class="prose" set:html={corpoB} />
            </>
          ) : (
            <div class="prose" set:html={corpo} />
          )}

          {ehPilar && filhas.length > 0 && (
            <div class="hub" style="margin-top:28px">
              {filhas.map((p) => (
                <a class="hub__i" href={p.path}>
                  <strong>{p.h1}</strong>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          )}

          {enriquecido?.faq && <FAQ itens={enriquecido.faq} />}

          {pagina.temCidades && <Cidades termo={pagina.h1} />}

          <div style="margin-top:40px;display:flex;gap:14px;flex-wrap:wrap">
            <a href="/contato" class="btn btn--green">Solicitar um orçamento</a>
            <a
              href={waLink(`Olá, gostaria de saber mais sobre ${pagina.h1}.`)}
              class="btn btn--outline"
              target="_blank"
              rel="noopener"
              data-evento="whatsapp_conteudo"
            >
              Orçamento por WhatsApp
            </a>
          </div>
        </div>

        <aside class="trilho">
          <div class="trilho__box">
            <h3>Fale com nossos especialistas</h3>
            <p>Atendimento em todo o território nacional. Resposta no mesmo dia útil.</p>
            <a href={`tel:${EMPRESA.telefoneLink}`} class="btn btn--green btn--sm" data-evento="click_telefone">
              {EMPRESA.telefone}
            </a>
          </div>

          {/* No pilar o hub principal já lista as irmãs — não repetir aqui. */}
          {!ehPilar && irmas.length > 1 && (
            <div class="trilho__box">
              <h3>{rotuloCluster}</h3>
              <ul class="trilho__lista">
                {irmas.slice(0, 12).map((p) => (
                  <li>
                    <a href={p.path} aria-current={p.path === pagina.path ? 'page' : undefined}>
                      {p.h1}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>
</Base>
