---
import Base from '../layouts/Base.astro';
import { EMPRESA, MENU_PRINCIPAL, DESCRICAO_CLUSTER, waLink } from '../config.mjs';
import { porPath, clustersComContagem } from '../lib/conteudo.mjs';

// Title e description da home REESCRITOS a pedido do cliente: a marca é
// "Segurança do Trabalho" — sem "automação industrial" (que é da CODA). Por
// isso não usamos mais o title/description preservados do site antigo aqui.
const atual = porPath('/');
const HOME_TITLE = 'Segurança do Trabalho - Previsio Engenharia';
const HOME_DESC =
  'Engenharia de segurança do trabalho: adequação NR-12, laudos, projetos e treinamentos. Do diagnóstico ao laudo com ART, com projeto e execução sob o mesmo teto. Desde 2016, atendimento em todo o Brasil.';

// NR-12 em destaque: é o carro-chefe declarado pelo cliente ("tem um monte de
// soluções, mas a gente vai sempre focar na NR-12"). As outras viram lista.
const clusters = clustersComContagem(MENU_PRINCIPAL);
const destaque = clusters.find((c) => c.id === 'nr-12');
const secundarias = clusters.filter((c) => c.id !== 'nr-12').slice(0, 5);

const ETAPAS = [
  { n: '01', t: 'Apreciação de risco', d: 'Levantamento em campo com HRN e ISO 13849.' },
  { n: '02', t: 'Inventário', d: 'Cadastro de máquinas com o grau de risco de cada uma.' },
  { n: '03', t: 'Projeto executivo', d: 'Desenhos, especificações e memorial descritivo.' },
  { n: '04', t: 'Adequação física', d: 'Proteções, intertravamentos, parada de emergência e LOTO.' },
  { n: '05', t: 'Laudo', d: 'Laudo de conformidade com ART do engenheiro responsável.' },
  { n: '06', t: 'Documentação', d: 'Prontuário e manual de instruções em português.' },
];
---

<Base
  title={HOME_TITLE}
  description={HOME_DESC}
  canonical="https://www.previsio.com.br/"
>
  <section class="hero hero--home">
    <div class="hero__media">
      <img
        src="/img/hero-home.jpg"
        alt="Engenheira com equipamento de proteção trabalhando em máquina industrial"
        width="1920"
        height="1277"
        fetchpriority="high"
      />
    </div>
    <div class="hero__scrim"></div>

    <div class="container">
      <div class="hero__in">
        <span class="eyebrow eyebrow--light">Desde {EMPRESA.desde} · Atendimento em todo o Brasil</span>
        <h1 class="hero__title">
          Segurança do trabalho que <span class="hl">não para</span> a sua produção
        </h1>
        <p class="hero__sub">
          Engenharia de segurança do trabalho: do diagnóstico ao
          laudo com ART, com projeto e execução sob o mesmo teto.
        </p>
        <div class="hero__cta">
          <a href="/contato" class="btn btn--green btn--lg">Solicitar orçamento</a>
          <a href={waLink()} class="btn btn--ghost btn--lg" target="_blank" rel="noopener" data-evento="whatsapp_hero">
            Falar no WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="trust">
    <div class="container">
      <div class="trust__in">
        {/* TODO(cliente): "+1.000 clientes" já está publicado no site atual e na
            LP-01, mas os números compilados nunca foram fornecidos. Confirmar. */}
        <div class="trust__i"><span class="trust__n">+1.000</span><span class="trust__l">indústrias atendidas</span></div>
        <div class="trust__i"><span class="trust__n">Desde {EMPRESA.desde}</span><span class="trust__l">no mercado</span></div>
        <div class="trust__i"><span class="trust__n">Projeto + Execução</span><span class="trust__l">no mesmo fornecedor</span></div>
        <div class="trust__i"><span class="trust__n">Laudo com ART</span><span class="trust__l">engenheiro responsável</span></div>
      </div>
    </div>
  </div>

  {/* Soluções — assimétrico: NR-12 grande com foto de obra real + lista */}
  <section class="sec">
    <div class="container">
      <div class="sec__head">
        <span class="eyebrow">Soluções</span>
        <h2 class="sec__title">Conformidade por norma, do laudo à obra</h2>
        <p class="sec__lead">
          Equipe multidisciplinar para atender as exigências legais da sua planta — com
          soluções técnicas que valorizam a produção e evitam multas e interdições.
        </p>
      </div>

      <div class="destaque">
        <a class="destaque__card" href={destaque.pilar}>
          {/* Foto real de proteção instalada em obra do próprio cliente —
              prova visual que nenhum concorrente da praça exibe. */}
          <img src="/imagens/informacoes/adequacao-nr12-02.webp" alt="Proteção mecânica instalada em máquina industrial" loading="lazy" />
          <div class="destaque__body">
            <span class="eyebrow eyebrow--light">Principal solução</span>
            <h3>NR-12 · Segurança em Máquinas</h3>
            <p>{DESCRICAO_CLUSTER['nr-12']}</p>
            <span class="btn btn--green btn--sm">Conhecer a solução</span>
          </div>
        </a>

        <div class="lista">
          {/* Sem numeração: são linhas de serviço paralelas, não etapas — e a
              sequência começando em "02" (por causa do destaque) confundia. */}
          {secundarias.map((c) => (
            <a class="lista__i" href={c.pilar}>
              <span class="lista__txt">
                <strong>{c.rotulo}</strong>
                <span>{DESCRICAO_CLUSTER[c.id]}</span>
              </span>
              <span class="lista__seta" aria-hidden="true">→</span>
            </a>
          ))}
          <p style="margin-top:26px">
            <a href="/servicos" class="btn btn--outline btn--sm">Ver todas as soluções</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Processo — timeline, não grade de cards */}
  <section class="sec sec--navy patterned">
    <div class="container">
      <div class="sec__head">
        <span class="eyebrow eyebrow--light">Como trabalhamos</span>
        <h2 class="sec__title">Da apreciação de risco ao prontuário</h2>
        <p class="sec__lead">
          Criamos conceitos, projetos e especificações buscando a compatibilidade das
          normas com as exigências de operação e manutenção de cada processo.
        </p>
      </div>

      <div class="timeline">
        {ETAPAS.map((e) => (
          <div class="tl">
            <div class="tl__dot">{e.n}</div>
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Diferencial — split com foto real, não cards */}
  <section class="sec">
    <div class="container">
      <div class="split">
        <div class="split__media">
          <img src="/imagens/informacoes/adequacao-nr12-01.webp" alt="Proteções instaladas em esteira transportadora" loading="lazy" />
          <span class="split__badge">Obra executada pela Previsio</span>
        </div>
        <div>
          <span class="eyebrow">Diferencial</span>
          <h2 class="sec__title">Projeta, executa e atesta</h2>
          <p style="color:var(--muted)">
            Fornecemos os projetos executivos com assessoria para o cliente realizar as
            adequações internamente e, após a adequação, emitimos o laudo de conformidade.
          </p>
          <ul class="checklist">
            <li>Inspeção completa, podendo ser realizada na sede do próprio fabricante</li>
            <li>Projeto e execução com um só fornecedor — sem repassar responsabilidade</li>
            <li>Laudo de conformidade com ART de engenheiro responsável</li>
            <li>Atuação em todo o território nacional e no exterior</li>
          </ul>
          <a href="/quem-somos" class="btn btn--outline">Conhecer a Previsio</a>
        </div>
      </div>
    </div>
  </section>

  {/* Riscos — faixa tipográfica, sem caixas */}
  <section class="sec sec--soft">
    <div class="container">
      <div class="sec__head">
        <span class="eyebrow">Por que agir agora</span>
        <h2 class="sec__title">Adiar custa caro — em três frentes</h2>
      </div>

      <div class="fatores">
        <div class="fator">
          <span class="fator__k">01</span>
          <h3>Risco humano</h3>
          <p>Cortes, esmagamentos e outros acidentes podem ser evitados pelas medidas corretivas.</p>
        </div>
        <div class="fator">
          <span class="fator__k">02</span>
          <h3>Risco financeiro</h3>
          <p>Indenizações, paralisações de linha e perda de contratos com clientes que auditam fornecedores.</p>
        </div>
        <div class="fator">
          <span class="fator__k">03</span>
          <h3>Risco jurídico</h3>
          <p>Multas, notificações e interdições, além do dano à credibilidade da empresa.</p>
        </div>
      </div>
    </div>
  </section>

  {/* CTA final com foto de fundo */}
  <section class="cta-foto">
    <img src="/img/cta-industria.jpg" alt="" />
    <div class="container">
      <div style="max-width:640px">
        <h2 class="sec__title">Fale com nossos especialistas</h2>
        <p style="color:var(--on-navy);font-size:1.07rem;margin-bottom:26px">
          Conte com a Previsio Engenharia para entender o que a sua planta precisa —
          e em que ordem.
        </p>
        <div class="hero__cta">
          <a href="/contato" class="btn btn--green btn--lg">Solicitar uma cotação</a>
          <a href={waLink()} class="btn btn--ghost btn--lg" target="_blank" rel="noopener" data-evento="whatsapp_cta_final">
            Orçamento por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
