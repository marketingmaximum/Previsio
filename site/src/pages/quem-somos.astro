---
import Base from '../layouts/Base.astro';
import { EMPRESA, waLink } from '../config.mjs';
import { porPath } from '../lib/conteudo.mjs';

// Conteúdo reaproveitado 1:1 do /quem-somos atual — nada inventado.
const pagina = porPath('/quem-somos');

// Logos de clientes já publicados na página atual (36 arquivos espelhados).
const logos = Array.from({ length: 38 }, (_, i) => i + 1)
  .filter((n) => n !== 31 && n !== 32) // 31 e 32 não existem no acervo original
  .map((n) => `/imagens/clientes/${String(n).padStart(2, '0')}.webp`);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Quem Somos - Previsio Engenharia',
  url: 'https://www.previsio.com.br/quem-somos',
};
---

<Base
  title={pagina?.title ?? 'Quem Somos - Previsio Engenharia'}
  description={pagina?.descriptionCorrigida ?? pagina?.description}
  canonical="https://www.previsio.com.br/quem-somos"
  schema={schema}
>
  <section class="hero hero--page">
    <div class="hero__media"><img src="/img/hero/institucional.jpg" alt="" width="1600" height="1064" /></div>
    <div class="hero__scrim"></div>
    <div class="container">
      <div class="hero__in">
        <ol class="crumb"><li><a href="/">Home</a></li><li>Quem somos</li></ol>
        <h1 class="hero__title">Quem Somos</h1>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">Quem somos</span>
          <h2 class="sec__title">Nós Somos a Previsio Engenharia</h2>
          <p style="color:var(--muted)">
            Somos uma empresa gaúcha de Engenharia de Segurança do Trabalho formada por
            uma equipe multidisciplinar de profissionais com ampla experiência técnica na
            condução de grandes projetos em todo território nacional e no exterior.
          </p>
          <p style="color:var(--muted)">A Previsio possui mão de obra técnica para atender todas as necessidades da sua empresa:</p>
          <ul class="checklist">
            <li>Documentações de segurança do trabalho</li>
            <li>Projeto</li>
            <li>Execução e manutenção</li>
            <li>Reforma</li>
            <li>Treinamentos</li>
          </ul>
        </div>
        <div class="split__media">
          <img src="/imagens/empresa/img-empresa.webp" alt="Previsio Engenharia" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--soft">
    <div class="container">
      <div class="grid grid--2">
        <div class="card">
          <div class="card__ico">◈</div>
          <h3>Diferenciais</h3>
          <p>
            Buscamos sempre assessorar nossos clientes com um olhar atento sobre os processos
            produtivos, entregando soluções técnicas valorizando a produção, minimizando custos
            e evitando multas e interdições. Nossos projetos são personalizados, integrados ao
            fluxo do cliente e atualizados em termos de normatização.
          </p>
        </div>
        <div class="card">
          <div class="card__ico">◉</div>
          <h3>Foco</h3>
          <p>
            Trabalhar com foco nas reais necessidades dos clientes para conquistar resultados
            positivos aos acionistas, sempre fundamentados na valorização contínua dos
            colaboradores, no respeito e admiração aos nossos fornecedores, no comprometimento e
            respeito com a sociedade e nos cuidados com o meio ambiente.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="trust">
    <div class="container">
      <div class="trust__in">
        <div class="trust__i"><span class="trust__n">Desde {EMPRESA.desde}</span><span class="trust__l">de atuação</span></div>
        <div class="trust__i"><span class="trust__n">+1.000</span><span class="trust__l">clientes atendidos</span></div>
        <div class="trust__i"><span class="trust__n">Nacional</span><span class="trust__l">e no exterior</span></div>
        <div class="trust__i"><span class="trust__n">Projeto à execução</span><span class="trust__l">tudo para sua empresa</span></div>
      </div>
    </div>
  </div>

  {/* Seção de logos de clientes em STAND-BY (03/08/2026): o cliente vai coletar
      as autorizações antes de exibir. Reativar quando liberarem. */}
  {false && (
    <section class="sec">
      <div class="container">
        <div class="sec__head" style="text-align:center;margin:0 auto 34px">
          <span class="eyebrow">Confiança</span>
          <h2 class="sec__title">Alguns de nossos clientes</h2>
        </div>
        <div class="logos">
          {logos.map((src) => (
            <div class="logos__i"><img src={src} alt="Cliente Previsio Engenharia" loading="lazy" /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="cta-foto">
    <img src="/img/cta-industria.jpg" alt="" />
    <div class="container">
      <div style="max-width:640px">
        <h2 class="sec__title">Fale com nossos especialistas</h2>
        <p style="color:var(--on-navy);font-size:1.07rem;margin-bottom:26px">
          Nossos especialistas irão retornar o mais breve possível.
        </p>
        <div class="hero__cta">
          <a href="/contato" class="btn btn--green btn--lg">Solicitar um orçamento</a>
          <a href={waLink()} class="btn btn--ghost btn--lg" target="_blank" rel="noopener" data-evento="whatsapp_quem_somos">Falar no WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>
